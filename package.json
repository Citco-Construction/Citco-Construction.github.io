{
  "name": "citco-construction-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:security": "tools/eslint/node_modules/.bin/eslint -c tools/eslint/eslint.config.mjs src scripts",
    "test": "jest --no-watchman",
    "compile": "tsc --noEmit",
    "check:unicode": "tsx scripts/check-unicode.ts",
    "dupes": "jscpd src --threshold 15",
    "test:e2e": "playwright test",
    "verify:dev": "npm run lint && npm run test && npm run lint:security && npm run compile && npm run check:unicode && npm run dupes && npm run test:e2e"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jscpd": "^5.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
